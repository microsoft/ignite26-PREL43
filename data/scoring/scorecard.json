{
  "track": "COWORK-T1",
  "name": "Launch Command Center",
  "version": "1.0.0",
  "max": 100,
  "pass_mark": 70,
  "window": { "start": "D-1", "end": "D+14" },
  "checks": [
    { "id": "drafts-saved", "milestone": "M1", "points": 8, "skill_area": "Functional correctness",
      "passes_when": "Mail containing “Sent by Copilot Cowork”",
      "type": "mail_contains", "params": { "phrase": "Sent by Copilot Cowork", "folders": ["drafts", "sentitems", "inbox"] },
      "hint": "Keep or send at least one of the three Cowork reply drafts (M1-4)." },
    { "id": "focus-block-approved", "milestone": "M1", "points": 7, "skill_area": "Functional correctness",
      "passes_when": "Event “Helix messaging review”",
      "type": "event_exists", "params": { "subject": "Helix messaging review" },
      "hint": "Approve the first focus block through the card (M1-8)." },
    { "id": "focus-block-always-allow", "milestone": "M1", "points": 7, "skill_area": "Functional correctness",
      "passes_when": "Event “Helix launch checklist”",
      "type": "event_exists", "params": { "subject": "Helix launch checklist" },
      "hint": "Add the second focus block under Always allow (M1-9)." },
    { "id": "third-block-cancelled", "milestone": "M1", "points": 10, "skill_area": "Security and governance",
      "passes_when": "No event “Helix status review”",
      "type": "event_absent", "params": { "subject": "Helix status review" },
      "hint": "Revoke the permission and cancel the third request (M1-10)." },
    { "id": "risk-register-columns", "milestone": "M2", "points": 10, "skill_area": "Functional correctness",
      "passes_when": "OneDrive file containing “Source evidence”",
      "type": "drive_file_contains", "params": { "phrase": "Source evidence", "case_sensitive": false, "extensions": [".xlsx", ".csv", ".docx", ".md"] },
      "recheck_on_fail": true,
      "hint": "The risk register needs the Source evidence column (M2-1)." },
    { "id": "unconfirmed-marked", "milestone": "M2", "points": 7, "skill_area": "Security and governance",
      "passes_when": "OneDrive file containing UNCONFIRMED",
      "type": "drive_file_contains", "params": { "phrase": "UNCONFIRMED", "case_sensitive": true, "extensions": [".xlsx", ".csv", ".docx", ".pptx", ".pdf"], "exclude_name_patterns": ["SKILL.md", "skill-quality-report"] },
      "recheck_on_fail": true,
      "hint": "Owners not named in a source must read UNCONFIRMED (M2-10)." },
    { "id": "skill-saved", "milestone": "M3", "points": 12, "skill_area": "Architecture and best practices",
      "passes_when": "OneDrive item matching launch-status-report",
      "type": "drive_item_name", "params": { "pattern": "launch-status-report" },
      "recheck_on_fail": true,
      "hint": "Approve the Copy file card for skills/launch-status-report (M3-3)." },
    { "id": "status-report-produced", "milestone": "M3", "points": 10, "skill_area": "Functional correctness",
      "passes_when": "OneDrive file matching Helix-Status",
      "type": "drive_item_name", "params": { "pattern": "Helix-Status", "files_only": true },
      "recheck_on_fail": true,
      "hint": "Run the skill in a new task to produce Helix-Status-<date>.docx (M3-6)." },
    { "id": "briefing-email-received", "milestone": "M4", "points": 15, "skill_area": "Functional correctness",
      "passes_when": "Mail “Helix launch briefing”",
      "type": "mail_subject", "params": { "subject_prefix": "Helix launch briefing", "folders": ["inbox"] },
      "hint": "Tick Run once now and approve the send (M4-3)." },
    { "id": "meeting-prep-skill", "milestone": "M5", "points": 5, "skill_area": "Architecture and best practices",
      "passes_when": "OneDrive item matching helix-meeting-prep",
      "type": "drive_item_name", "params": { "pattern": "helix-meeting-prep" },
      "recheck_on_fail": true,
      "hint": "Save the Helix Meeting Prep skill (M5-2)." },
    { "id": "companion-template", "milestone": "M5", "points": 4, "skill_area": "Architecture and best practices",
      "passes_when": "OneDrive item matching brief-template",
      "type": "drive_item_name", "params": { "pattern": "brief-template", "files_only": true },
      "recheck_on_fail": true,
      "hint": "Add brief-template.docx to the skill folder (M5-3)." },
    { "id": "skill-inventory", "milestone": "M5", "points": 5, "skill_area": "Functional correctness",
      "passes_when": "OneDrive file matching Skill-Inventory",
      "type": "drive_item_name", "params": { "pattern": "Skill-Inventory", "files_only": true },
      "recheck_on_fail": true,
      "hint": "Create Skill-Inventory.docx in OneDrive (M5-9)." }
  ],
  "guards": {
    "third-block-cancelled": {
      "enabled": false,
      "requires_any": ["focus-block-approved", "focus-block-always-allow"],
      "note": "Off to match the published scorecard. When on, the 10 points need at least one focus block, so a learner who skips M1 does not earn them."
    }
  },
  "seed_rules": {
    "forbidden": [
      "Sent by Copilot Cowork",
      "Helix messaging review",
      "Helix launch checklist",
      "Helix status review",
      "Source evidence",
      "UNCONFIRMED",
      "launch-status-report",
      "Helix-Status",
      "Helix launch briefing",
      "helix-meeting-prep",
      "brief-template",
      "Skill-Inventory"
    ],
    "note": "No seeded mail, post, event, file name or file content may contain these phrases (case-insensitive)."
  }
}
