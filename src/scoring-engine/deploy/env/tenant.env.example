# Scoring Engine deployment settings. Copy per tenant: cp tenant.env.example <name>.env
# Only the first block normally changes between tenants.

# ---- Where to deploy ---------------------------------------------------------
TENANT_ID=                                 # Entra tenant (Directory ID) the lab accounts live in
SUBSCRIPTION_ID=                           # Azure subscription in that tenant; you need Owner on it
LOCATION=eastus2                           # Azure region
RESOURCE_GROUP=vsl-scoring-rg              # created if missing
ADMIN_HOST=                                # e.g. scoring-admin.contoso.com; admin portal + lab partner API
SCORECARD_HOST=                            # e.g. scorecard.contoso.com; participant scorecard

# ---- Optional ----------------------------------------------------------------
ENV_NAME=prod                              # used in resource names and shown in the portal badge
NAME_PREFIX=vsl                            # resource name prefix
SIZE=standard                              # small (pilot/test) | standard (event scale, Postgres HA)
ADMIN_PRINCIPAL_ID=                        # object ID of the admin user/group; blank = the signed-in user
TLS_KEYVAULT_CERT_URI=                     # optional Key Vault certificate URI covering both hosts
IMAGE_TAG=1.0.0
AUTH_MODE=entra                            # entra (recommended) | local (test environments only)

# Filled in automatically by the app step (scripts/create-entra-apps.sh); leave blank on first run.
ENTRA_API_CLIENT_ID=
ENTRA_SPA_CLIENT_ID=
