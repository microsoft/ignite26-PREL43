{
  "name": "vectorsense-scoring-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:admin": "vite --config web-admin/vite.config.ts",
    "dev:scorecard": "vite --config web-scorecard/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:admin": "vite build --config web-admin/vite.config.ts",
    "build:scorecard": "vite build --config web-scorecard/vite.config.ts",
    "build": "npm run typecheck && npm run build:admin && npm run build:scorecard"
  },
  "dependencies": {
    "@azure/msal-browser": "3.27.0",
    "lucide-react": "0.460.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
